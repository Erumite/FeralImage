{
  "manifest_version": 3,
  "name": "FeralImage - Image Viewer",
  "version": "1.0.2",
  "description": "Smart viewer for standalone image tabs & base64 data URIs: auto-fit to screen, smooth wheel zoom, and Shift+Arrow 90° rotation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
